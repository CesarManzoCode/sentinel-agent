# Core runtime
SENTINEL_ENV=development
SENTINEL_PROFILE=balanced
SENTINEL_LOG_LEVEL=INFO
SENTINEL_DEBUG=false

# Groq
SENTINEL_GROQ_API_KEY=your_api_key_here
SENTINEL_GROQ_MODEL=llama-3.3-70b-versatile
SENTINEL_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Paths
SENTINEL_DATA_DIR=./data
SENTINEL_CONFIG_FILE=
SENTINEL_LOG_FORMAT=human

# Memory
SENTINEL_MEMORY_TOP_K=8
SENTINEL_MEMORY_EMBEDDING_DIM=384
SENTINEL_MEMORY_CONSOLIDATION_ENABLED=true

# Safety
SENTINEL_ALLOW_PRIVILEGED=false
SENTINEL_ENABLE_BWRAP=true
SENTINEL_APPROVAL_TTL_SECONDS=900
SENTINEL_WORKSPACE_ROOTS=~/work,~/projects,~/src

# Telemetry
SENTINEL_TRACE_PERSIST=true
SENTINEL_METRICS_ENABLED=true
